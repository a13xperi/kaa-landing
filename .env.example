# KAA Landing Page Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Site Configuration
# ===========================================

# The URL where this landing page is deployed
PUBLIC_SITE_URL=https://kaa-landing.vercel.app

# ===========================================
# App Integration URLs
# ===========================================

# Main application URL (where users go to register, login, checkout)
PUBLIC_APP_URL=https://app.karenaitkenassociates.com

# API URL (backend server for lead capture, etc.)
PUBLIC_API_URL=https://api.karenaitkenassociates.com

# ===========================================
# Feature Flags
# ===========================================

# Enable/disable lead capture form on landing page
PUBLIC_ENABLE_LEAD_CAPTURE=true

# Enable/disable direct checkout links (vs contact form)
PUBLIC_ENABLE_DIRECT_CHECKOUT=true

# ===========================================
# Analytics (Optional)
# ===========================================

# Google Analytics 4 Measurement ID
PUBLIC_GA_MEASUREMENT_ID=

# Plausible Analytics domain
PUBLIC_PLAUSIBLE_DOMAIN=

# ===========================================
# Third-party Integrations (Optional)
# ===========================================

# Typeform form ID for contact
PUBLIC_TYPEFORM_ID=Gqmo3i

# Calendly link for scheduling
PUBLIC_CALENDLY_URL=
